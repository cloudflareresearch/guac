{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "../scripts/*.ts"]
}
